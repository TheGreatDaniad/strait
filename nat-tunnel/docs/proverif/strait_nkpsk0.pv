(* Strait join handshake: Noise NKpsk0 with the personal-invite token in message 1.
   Symbolic model for ProVerif (run: proverif strait_nkpsk0.pv).

   Attacker: controls the network and holds the invite, so it knows the invite key (psk) and the
   host's public key (hk). It can run any number of its own guests. It does not have the host's
   private key, or the personal token of the honest guest.

   Message 1 (guest -> host): e, es, then AEAD(payload = clock || token)
   Message 2 (host -> guest): e, ee, then AEAD(payload = slot || verdict)
   Session key: from the chaining key after ee.

   What the model leaves out: the timestamp check and the replay cache (a replayed message 1 is
   only accepted again, which the host bounds; see HANDSHAKE.md), key rotation, and the
   rendezvous and carrier layers. *)

type G.
const g: G [data].
fun exp(G, bitstring): G.
equation forall x: bitstring, y: bitstring; exp(exp(g, x), y) = exp(exp(g, y), x).

(* Noise symmetric state: MixHash / MixKey as one-way functions of the chaining key. *)
fun h0(G): bitstring.                       (* initial hash: protocol name and the pre-message hk *)
fun mixpsk(bitstring, bitstring): bitstring.
fun mixe(bitstring, G): bitstring.          (* psk handshakes MixKey(e) as well as MixHash(e) *)
fun mixdh(bitstring, G): bitstring.
fun kenc(bitstring): bitstring.             (* the current cipher key *)
fun ksession(bitstring): bitstring.         (* Split(): the transport key *)

fun enc(bitstring, G, bitstring): bitstring.
reduc forall k: bitstring, ad: G, m: bitstring; dec(k, ad, enc(k, ad, m)) = m.

free c: channel.
free psk: bitstring.                        (* public: every invite holder has it *)
free token: bitstring [private].            (* the honest guest's personal token *)
free secret_data: bitstring [private].      (* traffic the honest guest sends in the session *)
free clock: bitstring.
free slot: bitstring.

event HostAccepted(G, G, G, bitstring).     (* hk, guest e, host e, session key *)
event GuestDone(G, G, G, bitstring).
event GuestSentToken(bitstring).
event HostSawToken(bitstring).

query attacker(token).
query attacker(secret_data).
query hk: G, eg: G, eh: G, k: bitstring; inj-event(GuestDone(hk, eg, eh, k)) ==> inj-event(HostAccepted(hk, eg, eh, k)).
query event(HostSawToken(token)) ==> event(GuestSentToken(token)).
(* Sanity: a join can complete, so the results above are not vacuous. Expected: "is false". *)
query hk: G, eg: G, eh: G, k: bitstring; event(GuestDone(hk, eg, eh, k)).

let Guest(hk: G) =
    new eg: bitstring;
    let EG = exp(g, eg) in
    let ck1 = mixe(mixpsk(h0(hk), psk), EG) in
    let ck2 = mixdh(ck1, exp(hk, eg)) in            (* es *)
    event GuestSentToken(token);
    out(c, (EG, enc(kenc(ck2), EG, (clock, token))));
    in(c, (EH: G, m2: bitstring));
    let ck3 = mixdh(mixe(ck2, EH), exp(EH, eg)) in  (* ee *)
    let s = dec(kenc(ck3), EH, m2) in
    let k = ksession(ck3) in
    event GuestDone(hk, EG, EH, k);
    out(c, enc(k, EG, secret_data)).

let Host(sh: bitstring) =
    let hk = exp(g, sh) in
    in(c, (EG: G, m1: bitstring));
    let ck1 = mixe(mixpsk(h0(hk), psk), EG) in
    let ck2 = mixdh(ck1, exp(EG, sh)) in            (* es *)
    let (ts: bitstring, t: bitstring) = dec(kenc(ck2), EG, m1) in
    event HostSawToken(t);
    new eh: bitstring;
    let EH = exp(g, eh) in
    let ck3 = mixdh(mixe(ck2, EH), exp(EG, eh)) in  (* ee *)
    let k = ksession(ck3) in
    event HostAccepted(hk, EG, EH, k);
    out(c, (EH, enc(kenc(ck3), EH, slot))).

process
    new sh: bitstring;
    let hk = exp(g, sh) in
    out(c, hk);
    ( (!Guest(hk)) | (!Host(sh)) )
