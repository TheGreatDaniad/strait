{
  "$description": "Strait design tokens. Source of truth for colours, type, spacing, radii, sizes and motion. Values match screens/*.html exactly.",
  "color": {
    "neutral": {
      "bg":            { "value": "#F5F8FA", "use": "Window background" },
      "surface":       { "value": "#FFFFFF", "use": "Cards, inputs, secondary buttons" },
      "subtle":        { "value": "#EEF3F6", "use": "Idle route nodes, ghost-button hover" },
      "track":         { "value": "#E9EFF3", "use": "Tab track, idle status chip" },
      "fieldDisabled": { "value": "#F6F9FB", "use": "Disabled / read-only field fill" },
      "border":        { "value": "#DFE7EC", "use": "Card borders, dividers" },
      "borderStrong":  { "value": "#CCD7DE", "use": "Input and secondary button borders" },
      "line":          { "value": "#B9C7D0", "use": "Idle route line (dashed), switch off" },
      "iconMuted":     { "value": "#8A9AA6", "use": "Idle status dot, disabled icons" },
      "textMuted":     { "value": "#576773", "use": "Secondary text, node labels, helper text" },
      "textLabel":     { "value": "#33424D", "use": "Field labels, section labels" },
      "text":          { "value": "#0F1C24", "use": "Primary text" }
    },
    "sea": {
      "base":   { "value": "#0E5A7A", "use": "Primary buttons, links, active state, 'you' half of the mark, sharing/connecting accent" },
      "hover":  { "value": "#0A4560", "use": "Primary hover, link hover, sharing chip text" },
      "strong": { "value": "#083B52", "use": "Sharing / connecting status title" },
      "line":   { "value": "#9CC3D6", "use": "Sharing route line" },
      "border": { "value": "#C3DCE8", "use": "Sharing / connecting status card border" },
      "tint":   { "value": "#E3EFF5", "use": "Sharing / connecting chip and node fill" }
    },
    "lagoon": {
      "base":   { "value": "#0F9D8A", "use": "Connected accent, other peer's half of the mark, packets, status dot" },
      "text":   { "value": "#0B7666", "use": "Connected chip text" },
      "strong": { "value": "#075E52", "use": "Connected status title" },
      "line":   { "value": "#8FD6CA", "use": "Connected route line" },
      "border": { "value": "#BCE7DF", "use": "Connected status card border" },
      "tint":   { "value": "#E0F5F1", "use": "Connected chip and node fill" },
      "onSea": { "value": "#7FE3D3", "use": "Lagoon used on deep-sea backgrounds (app icon)" }
    },
    "ember": {
      "base":            { "value": "#C2410C", "use": "Error accent: failed dot, ✕ badge, invalid input border" },
      "text":            { "value": "#9A3412", "use": "Error title, error helper text, failed chip text" },
      "border":          { "value": "#F5CDB5", "use": "Error status card border" },
      "tint":            { "value": "#FDEBE1", "use": "Failed chip fill, danger-button hover" },
      "dangerText":      { "value": "#B43C0D", "use": "Disconnect button text" },
      "dangerBorder":    { "value": "#F1C2A6", "use": "Disconnect button border" }
    },
    "onPrimary": { "value": "#FFFFFF", "use": "Text on deep-sea buttons" }
  },
  "font": {
    "family": {
      "brand": { "value": "'Fraunces', Georgia, serif", "use": "Wordmark only — italic", "weights": [600] },
      "ui":    { "value": "'Inter', system-ui, sans-serif", "use": "All interface text", "weights": [400, 500, 600, 700] },
      "mono":  { "value": "'JetBrains Mono', ui-monospace, monospace", "use": "Invite codes, relay addresses, IPs, timers, byte counts", "weights": [400, 500] }
    },
    "scale": {
      "wordmark":    { "size": 19, "weight": 600, "family": "brand", "letterSpacing": "-0.01em" },
      "statusTitle": { "size": 17, "weight": 600, "family": "ui" },
      "button":      { "size": 15, "weight": 600, "family": "ui" },
      "body":        { "size": 14, "weight": 400, "family": "ui" },
      "tab":         { "size": 14, "weight": "500 inactive / 600 active", "family": "ui" },
      "label":       { "size": 13, "weight": 600, "family": "ui", "color": "textLabel" },
      "helper":      { "size": 13, "weight": 400, "family": "ui", "color": "textMuted" },
      "chip":        { "size": 12, "weight": 600, "family": "ui" },
      "nodeLabel":   { "size": 12, "weight": 500, "family": "ui" },
      "statLabel":   { "size": 12, "weight": 500, "family": "ui" },
      "code":        { "size": 13, "weight": 400, "family": "mono" },
      "statValue":   { "size": 14, "weight": 400, "family": "mono" }
    }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "windowPadding": 20 },
  "radius": { "tab": 9, "input": 10, "track": 12, "button": 12, "statCard": 12, "chip": 13, "card": 16, "node": "50%", "appIcon": "27% of icon size" },
  "size": {
    "window":       { "width": 420, "height": 560, "resizable": false },
    "buttonHeight": 48,
    "inputHeight":  44,
    "tabHeight":    36,
    "chipHeight":   26,
    "statusDot":    7,
    "routeNode":    52,
    "routeIcon":    24,
    "switch":       { "width": 40, "height": 24, "knob": 18 },
    "logoInHeader": 22,
    "trayIcon":     16
  },
  "shadow": {
    "activeTab": "0 1px 2px rgba(15,28,36,0.1)",
    "switchKnob": "0 1px 2px rgba(15,28,36,0.2)"
  },
  "motion": {
    "packetFlow":     { "duration": "1.6s", "easing": "linear", "iteration": "infinite", "note": "2 dots per route segment, second delayed -0.8s" },
    "connectingMarch":{ "duration": "0.6s", "easing": "linear", "iteration": "infinite", "note": "dashed line pattern 6px on / 6px off scrolls toward host" },
    "connectingPulse":{ "duration": "1.4s", "easing": "ease-in-out", "iteration": "infinite", "note": "ring 0→8px around 'You' node" },
    "switch":         { "duration": "0.15s" },
    "reducedMotion":  "Disable all of the above when prefers-reduced-motion: reduce (hide packets, stop pulse/march)."
  }
}
